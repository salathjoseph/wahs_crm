# WAHS CRM Environment Configuration Example
# Copy this file to '.env' and fill in your Supabase credentials.

# Your Supabase Project API URL (found under Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Key (found under Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
